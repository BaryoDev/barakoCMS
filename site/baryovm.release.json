{
  "localRoot": "~/repos/barakoCMS/site",
  "remoteRoot": "/var/www/barakocms-site",
  "sync": [
    "out/"
  ],
  "builds": [],
  "sudo": true,
  "noCompose": true,
  "postDeploy": [
    "sudo restorecon -R /var/www/barakocms-site || true",
    "sudo nginx -t",
    "sudo systemctl reload nginx"
  ],
  "verify": [
    "curl --fail --silent --show-error --max-time 10 -o /dev/null https://barakocms.com",
    "curl --fail --silent --show-error --max-time 10 -o /dev/null -w '%{http_code}' https://barakocms.com | grep -q 200"
  ]
}

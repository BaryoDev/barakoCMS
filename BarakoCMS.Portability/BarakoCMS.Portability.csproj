<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BarakoCMS.Portability</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BarakoCMS.Portability</PackageId>
    <Version>5.0.0</Version>
    <Description>Content portability for barakoCMS: adds the contents section to config export, plan and apply, so content-type definitions and their content data move between instances as one JSON document (upsert types by name, recreate content via events). For backup, migration, seeding, and sharing content-type templates.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BarakoCMS.Abstractions\BarakoCMS.Abstractions.csproj" />
    <ProjectReference Include="..\barakoCMS\barakoCMS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="barakoCMS.Modules.BarakoModuleAssembly" />
  </ItemGroup>
</Project>

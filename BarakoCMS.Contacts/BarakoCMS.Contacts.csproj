<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BarakoCMS.Contacts</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BarakoCMS.Contacts</PackageId>
    <Version>5.2.0</Version>
    <Description>Contacts for barakoCMS: one record for a person or an organization, with typed custom fields, person to organization links, email deduplication with a merge endpoint, tenant scoping and capability-gated access. Email, phone and address are Sensitive and never leave over anonymous delivery.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BarakoCMS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BarakoCMS.Abstractions\BarakoCMS.Abstractions.csproj" />
    <ProjectReference Include="..\barakoCMS\barakoCMS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\migrations\5.2.0\contacts.sql" LogicalName="barako-migrations/5.2.0/contacts.sql" />
  </ItemGroup>
</Project>

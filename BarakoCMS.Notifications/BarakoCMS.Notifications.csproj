<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BarakoCMS.Notifications</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BarakoCMS.Notifications</PackageId>
    <Version>5.2.0</Version>
    <Description>Notifications for barakoCMS: any module raises a notification for a user, it lands in that user's in-app inbox (list, unread count, mark read) and is also handed to any delivery sink registered beside it, such as the built-in email sink. Tenant-scoped, and a user sees only their own.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BarakoCMS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BarakoCMS.Abstractions\BarakoCMS.Abstractions.csproj" />
    <ProjectReference Include="..\barakoCMS\barakoCMS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\migrations\5.2.0\notifications.sql" LogicalName="barako-migrations/5.2.0/notifications.sql" />
  </ItemGroup>
</Project>

<Project>

  <!-- Central Package Management. Projects reference packages without a version:
         <PackageReference Include="Marten" />
       Every version lives here, so two projects can never drift onto different versions
       of the same dependency. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Web and API">
    <PackageVersion Include="FastEndpoints" Version="8.3.0" />
    <PackageVersion Include="FastEndpoints.Security" Version="8.3.0" />
    <PackageVersion Include="FastEndpoints.Swagger" Version="8.3.0" />
  </ItemGroup>

  <ItemGroup Label="Resilience">
    <!-- The retry, timeout and breaker inside one workflow attempt (#703). BaryoDev's own library,
         zero dependencies. Replaced Microsoft.Extensions.Http.Resilience, whose standard handler
         retried a POST after a timeout with no way for the receiver to know. -->
    <PackageVersion Include="Carom" Version="2.0.1" />
    <PackageVersion Include="Carom.Extensions" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup Label="Persistence and storage">
    <PackageVersion Include="Marten" Version="9.40.0" />
    <!-- Marten 9 already brings JasperFx transitively; referenced explicitly because the host
         calls RunJasperFxCommands for the db-patch / db-assert / db-apply schema commands, and a
         compile-time dependency should not rest on someone else's dependency graph. -->
    <PackageVersion Include="JasperFx" Version="2.75.2" />
    <!-- Was floating (3.7.*) before central management, so two builds of the same commit could
         resolve different versions. Pinned to what it last resolved to. -->
    <PackageVersion Include="AWSSDK.S3" Version="3.7.511.8" />
    <PackageVersion Include="Talaan" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup Label="Imaging">
    <!-- Fully managed, so it resizes on linux/arm64 in a container with no native libgdiplus or
         libvips to install, which is what ruled out the alternatives. Pinned: an imaging decoder is
         exactly the dependency where "whatever floats to" is how a CVE arrives unannounced. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup Label="Security">
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageVersion Include="IdentityModel" Version="7.0.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <PackageVersion Include="AspNetCore.HealthChecks.Npgsql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.System" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="9.0.0" />
    <!-- Tracing. Nothing here is registered unless Tracing:Otlp:Endpoint is set; see
         docs/tracing.md. The two instrumentation packages release on their own version line. -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Email">
    <!-- MailKit rather than System.Net.Mail.SmtpClient, which Microsoft's own docs tell you not to
         use for new code. Brings MimeKit with it. -->
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <!-- Email template bodies are markdown. Markdig is BSD-2-Clause with no dependencies on
         net10.0, and the pipeline it is used with turns raw HTML off. -->
    <PackageVersion Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="KubernetesClient" Version="18.0.13" />
    <!-- Module discovery reads the application's deps.json through this. Already resolved
         transitively (Serilog.Settings.Configuration, Mvc.Testing); referenced directly because
         core now compiles against it. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="FastEndpoints.Testing" Version="8.3.0" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- BarakoCMS.Testing hosts a real barakoCMS over TestServer without a Program.cs to point
         WebApplicationFactory at, so it takes the TestHost package directly. Same version line as
         Mvc.Testing, which depends on it. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <!-- Transitive via Testcontainers. Pinned ahead of what it asks for because 2025.1.0 carries
         GHSA-q939-rpr3-3284 (High). Transitive pinning is on, so this is the whole fix. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <!-- The core assembly on its own, for BarakoCMS.Testing. It implements IAsyncLifetime so a
         module's tests can use it as a class fixture, and this package carries that type without
         the MSBuild targets that would turn a library into a test project. Same version as
         xunit.v3, which depends on it. -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>

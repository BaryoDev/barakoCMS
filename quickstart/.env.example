# ─────────────────────────────────────────────────────────────────────────────
# barakoCMS quickstart configuration.  cp .env.example .env  then edit.
# Only the "Required" block is needed to boot. Everything else is optional and
# stays off (or uses a safe mock) until you fill it in.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
DB_PASSWORD=change-me-to-a-strong-password
# JWT signing key — MUST be at least 32 characters, or the API won't start.
JWT_KEY=change-me-to-at-least-32-characters-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── URLs & ports ─────────────────────────────────────────────────────────────
# What the browser uses to reach the API. Behind a reverse proxy, set your public URL
# (e.g. https://cms.example.com) and add it to ALLOWED_ORIGINS.
#
# This compose file starts the API and Postgres only, no console. ALLOWED_ORIGINS defaults to
# :3000 because that is where BaryoDev/barakoBrew's own quickstart serves the console when you
# run the two side by side; PUBLIC_API_URL and ADMIN_PORT below are not read by this file, they
# match the variable names barakoBrew's quickstart expects so the pairing is documented in one
# place. Running only this file, set ALLOWED_ORIGINS to wherever your own frontend actually is.
PUBLIC_API_URL=http://localhost:5005
ALLOWED_ORIGINS=http://localhost:3000
API_PORT=5005
ADMIN_PORT=3000
# Required. The release to run, for example 5.9.0. There is no latest default, because the next
# `docker compose pull` would be an unplanned upgrade. Releases: github.com/BaryoDev/barakoCMS/releases
BARAKO_TAG=5.9.0
# The address the API port is published on. 127.0.0.1 keeps it on this machine. Set 0.0.0.0 to reach
# it from another machine, and put TLS in front of it first.
API_BIND=127.0.0.1
# 'Development' relaxes some checks for local trials; use 'Production' for real deploys.
ASPNETCORE_ENVIRONMENT=Production
# Host names the API answers to, separated by ';'. Production refuses to start with '*'. Set your domain here.
# To open it from another machine, add that IP or name, e.g. ALLOWED_HOSTS=localhost;127.0.0.1;192.168.1.20
ALLOWED_HOSTS=localhost;127.0.0.1
# Set true to seed the sample AttendanceRecord content type, its demo records and its
# "Attendance Confirmation Email" workflow, if you want something to click through. That
# workflow is stored active, so leave this false on anything real.
SEED_DEMO_CONTENT=false

# -- Email, SMTP module (optional) ----------------------------------------
# Leave the host blank to use the built-in mock (emails are logged, not sent).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Your App <no-reply@yourdomain.com>

# ── Analytics — Umami module (optional) ──────────────────────────────────────
# Point at your own self-hosted Umami. Set UMAMI_ENABLED=true to turn the section on.
UMAMI_ENABLED=false
# Server-to-server URL (include Umami's base path if it runs under one, e.g. .../analytics).
UMAMI_BASEURL=http://umami:3000
UMAMI_USERNAME=
UMAMI_PASSWORD=
# Public origin the tracking script is served from (used to build the copy-paste snippet).
UMAMI_PUBLICURL=

# ── Social sign-in — ExternalAuth module (optional) ──────────────────────────
# Master switch. Leave false to keep only email-code / password sign-in.
EXTERNALAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Device trust (optional) ──────────────────────────────────────────────────
# true = a new device must be approved via an emailed code before it can call the API.
DEVICETRUST_ENFORCE=false

# ── Object storage for public media — Files.S3 module (optional) ─────────────
# Leave FILES__S3__BUCKET empty to keep the built-in Postgres file storage (bytes in the database).
# Set it to store uploads in an S3-compatible bucket instead. The same keys drive AWS S3, Cloudflare
# R2, SeaweedFS and Garage; public files then get a direct, CDN-friendly URL. MinIO is archived and
# gets no security patches, so it is not recommended. Only when a bucket is set does the S3 provider
# take over.
FILES__S3__BUCKET=
# R2 or self-hosted endpoint (e.g. https://<account>.r2.cloudflarestorage.com or http://seaweedfs:8333).
# Leave empty for AWS S3, which is reached via the region below.
FILES__S3__SERVICEURL=
FILES__S3__REGION=us-east-1
FILES__S3__ACCESSKEY=
FILES__S3__SECRETKEY=
# The public base URL public objects are served from (a bucket public URL, an R2 public/custom domain,
# or a CDN in front). Combined with the object key to form each public file's URL.
FILES__S3__PUBLICBASEURL=
# Only AWS S3, on a bucket with ACLs enabled, applies a public-read ACL to public objects. R2,
# SeaweedFS and Garage ignore it: set this false and make the bucket public instead.
FILES__S3__USEPUBLICREADACL=true

# Resource limits (optional)
# Each service has a memory and process cap, so one runaway container cannot take the host down.
# The defaults are generous. Raise API_MEM_LIMIT before a large import or a big file upload, for
# example API_MEM_LIMIT=2g. Do not set a value to 0 or -1, which removes the cap.
# API_MEM_LIMIT=1g
# API_PIDS_LIMIT=512
# API_TMP_SIZE=512m          # scratch space for uploads in flight, held in memory. 0 removes the cap, so do not set it
# DB_MEM_LIMIT=2g
# DB_PIDS_LIMIT=512
# BACKUP_MEM_LIMIT=512m
# BACKUP_PIDS_LIMIT=128
# EXTENSIONS_MEM_LIMIT=128m
# EXTENSIONS_PIDS_LIMIT=64
# The backup container has a read-only root file system. The off-host copy installs curl on first
# start, which needs a writable one, so set BACKUP_READ_ONLY=false only when BACKUP_S3_BUCKET is set.
# BACKUP_READ_ONLY=true

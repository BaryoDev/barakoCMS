<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BarakoCMS.Accounting</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BarakoCMS.Accounting</PackageId>
    <Version>4.6.0</Version>
    <Description>Optional double-entry accounting module for barakoCMS: accounts, balanced journal entries, and reporting.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core types (FastEndpoints endpoints) in a class library. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BarakoCMS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BarakoCMS.Abstractions\BarakoCMS.Abstractions.csproj" />
    <ProjectReference Include="..\barakoCMS\barakoCMS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>
  <ItemGroup>
    <!-- The module's own migrations, for db-migrate (docs/migrations.md). -->
    <EmbeddedResource Include="..\migrations\5.0.0\accounting-number-sequences.sql" LogicalName="barako-migrations/5.0.0/accounting-number-sequences.sql" />
    <EmbeddedResource Include="..\migrations\5.3.0\accounting-journal-lifecycle.sql" LogicalName="barako-migrations/5.3.0/accounting-journal-lifecycle.sql" />
    <EmbeddedResource Include="..\migrations\5.3.0\accounting-mappings.sql" LogicalName="barako-migrations/5.3.0/accounting-mappings.sql" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BarakoCMS.Forms</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BarakoCMS.Forms</PackageId>
    <Version>0.1.2</Version>
    <Description>Form submissions for barakoCMS: define a form and its fields per tenant, take anonymous submissions at POST /api/public/forms/{name} behind a honeypot, a body cap and a per-address rate limit, then list, read and export them as CSV and email the people who asked to be told.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\barakoCMS\barakoCMS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>
</Project>

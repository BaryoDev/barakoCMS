<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BarakoCMS.Scheduling</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BarakoCMS.Scheduling</PackageId>
    <Version>5.2.0</Version>
    <Description>Scheduling module for barakoCMS: schedule a named action for a due time, and exactly one API instance hands it to the registered handler when the time comes. Never fires the same entry twice.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BarakoCMS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BarakoCMS.Abstractions\BarakoCMS.Abstractions.csproj" />
    <ProjectReference Include="..\barakoCMS\barakoCMS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module's own tables, for db-migrate (docs/migrations.md). -->
    <EmbeddedResource Include="..\migrations\5.2.0\scheduled-entries.sql" LogicalName="barako-migrations/5.2.0/scheduled-entries.sql" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BarakoCMS.Payments</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BarakoCMS.Payments</PackageId>
    <Version>0.1.0</Version>
    <Description>Payments for barakoCMS: a content type declares what is payable, a public checkout returns the provider's hosted URL for the amount stored on the entry, and a signed, idempotent webhook runs the paid transition.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BarakoCMS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BarakoCMS.Abstractions\BarakoCMS.Abstractions.csproj" />
    <ProjectReference Include="..\barakoCMS\barakoCMS.csproj" />
  </ItemGroup>
</Project>

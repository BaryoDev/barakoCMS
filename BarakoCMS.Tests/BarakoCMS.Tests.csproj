<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints.Testing" />
    <PackageReference Include="Marten" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Minio" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\barakoCMS\barakoCMS.csproj" />
    <ProjectReference Include="..\BarakoCMS.Diagnostics\BarakoCMS.Diagnostics.csproj" />
    <ProjectReference Include="..\BarakoCMS.Files.S3\BarakoCMS.Files.S3.csproj" />
    <ProjectReference Include="..\BarakoCMS.AI\BarakoCMS.AI.csproj" />
    <ProjectReference Include="..\BarakoCMS.Accounting\BarakoCMS.Accounting.csproj" />
    <ProjectReference Include="..\BarakoCMS.Pwa\BarakoCMS.Pwa.csproj" />
    <ProjectReference Include="..\BarakoCMS.FeatureFlags\BarakoCMS.FeatureFlags.csproj" />
    <ProjectReference Include="..\BarakoCMS.Email.Resend\BarakoCMS.Email.Resend.csproj" />
    <!-- ExternalAuth had no test project reference and therefore no tests, which is why nothing
         noticed that three of its four providers never checked whether the email they were handed
         was verified. A module that cannot be reached by a test is not under-tested, it is
         untestable. -->
    <ProjectReference Include="..\BarakoCMS.ExternalAuth\BarakoCMS.ExternalAuth.csproj" />
    <!-- Portability had no test project reference either, and its import path silently dropped a
         content type's public-delivery flag as a result. -->
    <ProjectReference Include="..\BarakoCMS.Portability\BarakoCMS.Portability.csproj" />
    <!-- DeviceTrust decides whether an authenticated request is allowed to proceed, and its failure
         mode is silence: if binding stops working, sign-in still succeeds and tokens are simply
         accepted from anywhere. Nothing could reach it from here until now. See #121. -->
    <ProjectReference Include="..\BarakoCMS.DeviceTrust\BarakoCMS.DeviceTrust.csproj" />
    <ProjectReference Include="..\BarakoCMS.Import\BarakoCMS.Import.csproj" />
    <!-- The Umami module exists to keep the analytics credentials server side. That is a claim about
         what crosses the wire, so it can only be checked from a test project that can call the
         endpoints. See #123. -->
    <ProjectReference Include="..\BarakoCMS.Analytics.Umami\BarakoCMS.Analytics.Umami.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BarakoCMS.Secrets.Aws</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BarakoCMS.Secrets.Aws</PackageId>
    <Version>5.0.0</Version>
    <Description>Loads barakoCMS configuration values, such as JWT:Key, Secrets:Key and module credentials, from AWS Secrets Manager at startup, authenticating as the instance's own role. A mapped secret that cannot be read stops startup with a message naming the secret, never its value.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SecretsManager" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BarakoCMS.Tests" />
  </ItemGroup>
</Project>

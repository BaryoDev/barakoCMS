<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BarakoCMS.Secrets.Gcp</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BarakoCMS.Secrets.Gcp</PackageId>
    <Version>5.0.1</Version>
    <Description>Loads barakoCMS configuration values, such as JWT:Key, Secrets:Key and module credentials, from Google Secret Manager at startup, authenticating as the instance's own service account. A mapped secret that cannot be read stops startup with a message naming the secret, never its value.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.SecretManager.V1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BarakoCMS.Tests" />
  </ItemGroup>
</Project>

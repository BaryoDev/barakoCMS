# "Barako" — the full-suite image: the barakoCMS engine with every module registered.
# Built and pushed as ghcr.io/baryodev/barako-cms (the default, caffeinated pour).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
# The implicit restore inside publish runs in locked mode against the committed packages.lock.json
# files, which COPY . . brought in with everything else.
RUN dotnet publish "BarakoCMS.Suite/BarakoCMS.Suite.csproj" -c Release -o /app/publish /p:UseAppHost=false /p:RestoreLockedMode=true
# The Files module's image resizer ships Skia's native library for every platform it supports, and a
# portable publish copies all of them, Windows debug symbols included: hundreds of megabytes this
# image can never load. Keep the one for the architecture being built. This stage runs on the target
# platform, so uname reports that architecture, also under emulation in a multi-arch build. Only
# native folders are touched; managed runtimes/ assemblies stay.
RUN case "$(uname -m)" in \
      x86_64) keep=linux-x64 ;; \
      aarch64) keep=linux-arm64 ;; \
      *) echo "no Skia native library for $(uname -m)" >&2; exit 1 ;; \
    esac \
    && test -f "/app/publish/runtimes/$keep/native/libSkiaSharp.so" \
    && find /app/publish/runtimes -mindepth 2 -maxdepth 2 -type d -name native ! -path "*/runtimes/$keep/native" -exec rm -rf {} + \
    && find /app/publish/runtimes -mindepth 1 -maxdepth 1 -type d -empty -delete

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080

# The commit this image was built from, served back on /health/build so a deploy can prove it is
# running the build that is about to be published rather than the one already there. .git is in
# .dockerignore, so this cannot be read from the source tree; it has to be passed in.
ARG BARAKO_BUILD_SHA=""
ENV BARAKO_BUILD_SHA=$BARAKO_BUILD_SHA

# Non-root. The base image ships app as uid 1654 for this, and nothing here needs privilege: 8080 is
# above 1024 so an unprivileged user can bind it, and the app writes nothing to the container
# filesystem at runtime. Uploads go to the Files module's configured store.
#
# No compose file in this repository mounts a host path into the API, so nothing shipped breaks. The
# caveat is for anyone who adds one: a directory owned by root is not writable by uid 1654, and that
# fails at the mount rather than here.
USER app

ENTRYPOINT ["dotnet", "BarakoCMS.Suite.dll"]

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BarakoCMS.Reports</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BarakoCMS.Reports</PackageId>
    <Version>5.2.0</Version>
    <Description>Reports for barakoCMS: save a report over a client's own content (a content type, filters, one group-by field and count, sum, avg, min or max measures), run it with a date range, and export it as CSV. Totals are computed in the database, bounded by a group limit, and follow the reader: row conditions apply and a field the role cannot read cannot be grouped or measured.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BarakoCMS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BarakoCMS.Abstractions\BarakoCMS.Abstractions.csproj" />
    <ProjectReference Include="..\barakoCMS\barakoCMS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module's own tables, for db-migrate (docs/migrations.md). -->
    <EmbeddedResource Include="..\migrations\5.2.0\report-definitions.sql" LogicalName="barako-migrations/5.2.0/report-definitions.sql" />
  </ItemGroup>
</Project>

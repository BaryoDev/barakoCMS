# barakoCMS — environment for the all-in-one stack (docker-compose.hub.yml).
#   cp .env.example .env   (required. Set DB_PASSWORD, DB_APP_PASSWORD and JWT_SECRET below, the compose refuses to start without them, and BARAKO_TAG pins the release)
#
#   docker compose -f docker-compose.hub.yml up -d
#   API on http://localhost:5005. The console is BaryoDev/barakoBrew and runs from its own quickstart.
#   Sign in as ADMIN_USER, with the password you set below or the generated one in the API log.
#
# NEVER commit your real .env to source control.

# --- Image ---
# Required. The release to run, for example 5.9.0. There is no latest default, because the next
# `docker compose pull` would be an unplanned upgrade. Releases: github.com/BaryoDev/barakoCMS/releases
BARAKO_TAG=5.9.0

# --- Postgres ---
DB_NAME=barako_cms
DB_USER=postgres
# Required. Generate one: openssl rand -base64 24
DB_PASSWORD=
# Required. The password of the role the API connects as (DB_APP_USER, no superuser). A one-shot job
# creates the role on start. Keep it different from DB_PASSWORD. Generate one: openssl rand -base64 24
DB_APP_USER=barako_app
DB_APP_PASSWORD=

# --- Security ---
# JWT signing key. MUST be at least 32 characters or the API refuses to start. Required. Generate one: openssl rand -base64 48
JWT_SECRET=

# First admin, seeded on first start (this is your first sign-in).
# Leave ADMIN_PASSWORD unset and the API generates one on first boot and prints it once:
#   docker compose -f docker-compose.hub.yml logs app | grep InitialAdmin
# Set it here to choose your own. It must be 12+ characters with upper, lower, a digit and a symbol.
ADMIN_USER=admin
# ADMIN_PASSWORD=

# The OpenAPI explorer at /swagger. Off in the hub stack unless you ask for it.
# SWAGGER_ENABLED=true

# --- Optional integrations (leave unset to skip) ---
# Email (SMTP module), enables OTP email sign-in. Leave Host blank to use the built-in mock, which logs instead of sending.
# Modules__Email.Smtp__Host=smtp.example.com
# Modules__Email.Smtp__User=
# Modules__Email.Smtp__Password=
# Modules__Email.Smtp__From=BarakoCMS <noreply@example.com>

# --- Resource limits (optional) ---
# Each service has a memory and process cap, so one runaway container cannot take the host down.
# The defaults are generous. Raise API_MEM_LIMIT before a large import or a big file upload, for
# example API_MEM_LIMIT=2g. Do not set a value to 0 or -1, which removes the cap.
# API_MEM_LIMIT=1g
# API_PIDS_LIMIT=512
# API_TMP_SIZE=512m          # scratch space for uploads in flight, held in memory. 0 removes the cap, so do not set it
# DB_MEM_LIMIT=2g
# DB_PIDS_LIMIT=512
# EXTENSIONS_MEM_LIMIT=128m
# EXTENSIONS_PIDS_LIMIT=64

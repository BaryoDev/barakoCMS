# barakoCMS — environment for the all-in-one stack (docker-compose.hub.yml).
#   cp .env.example .env   (optional — the compose ships with working defaults for a local try-out)
#
#   docker compose -f docker-compose.hub.yml up -d
#   API on http://localhost:5005. The console is BaryoDev/barakoBrew and runs from its own quickstart.
#   Sign in as ADMIN_USER, with the password you set below or the generated one in the API log.
#
# NEVER commit your real .env to source control.

# --- Postgres ---
DB_NAME=barako_cms
DB_USER=postgres
DB_PASSWORD=postgres

# --- Security ---
# JWT signing key. MUST be at least 32 characters or the API refuses to start. Change for real use.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# First admin, seeded on first start (this is your first sign-in).
# Leave ADMIN_PASSWORD unset and the API generates one on first boot and prints it once:
#   docker compose -f docker-compose.hub.yml logs app | grep InitialAdmin
# Set it here to choose your own. It must be 12+ characters with upper, lower, a digit and a symbol.
ADMIN_USER=admin
# ADMIN_PASSWORD=

# The OpenAPI explorer at /swagger. Off in the hub stack unless you ask for it.
# SWAGGER_ENABLED=true

# --- Optional integrations (leave unset to skip) ---
# Email (Resend) — enables OTP email sign-in; falls back to a mock logger if unset.
# Resend__ApiKey=re_xxxxxxxx
# Resend__From=BarakoCMS <onboarding@resend.dev>

{
  "name": "site",
  "description": "A site's identity, theme and chrome as one entry per tenant, so a renderer reads its look from content instead of a config file. See docs/site-settings.md for the shape of each JSON field.",
  "contentTypes": [
    {
      "name": "site",
      "displayName": "Site",
      "description": "The one entry that makes this tenant's site look and read like itself.",
      "isPubliclyDeliverable": true,
      "isSingleton": true,
      "fields": [
        { "name": "Name", "displayName": "Site name", "type": "string", "isRequired": true },
        { "name": "Tagline", "displayName": "Tagline", "type": "string" },
        { "name": "Url", "displayName": "Site address", "type": "url" },
        { "name": "Locale", "displayName": "Locale", "type": "string" },
        { "name": "Currency", "displayName": "Currency", "type": "string" },
        { "name": "TimeZone", "displayName": "Time zone", "type": "string" },
        { "name": "Logo", "displayName": "Logo", "type": "url" },
        { "name": "LogoAlt", "displayName": "Logo alt text", "type": "string" },
        { "name": "FooterLogo", "displayName": "Footer logo", "type": "url" },
        { "name": "Favicon", "displayName": "Favicon", "type": "url" },
        { "name": "ShareImage", "displayName": "Default share image", "type": "url" },
        { "name": "Colors", "displayName": "Colours", "type": "json", "jsonSchema": {"type": "object", "additionalProperties": {"type": "string"}} },
        { "name": "Fonts", "displayName": "Fonts", "type": "json", "jsonSchema": {"type": "object", "additionalProperties": {"type": "string"}} },
        { "name": "Radii", "displayName": "Corner radii", "type": "json", "jsonSchema": {"type": "object", "additionalProperties": {"type": "string"}} },
        { "name": "Layout", "displayName": "Widths", "type": "json", "jsonSchema": {"type": "object", "additionalProperties": {"type": "string"}} },
        { "name": "Space", "displayName": "Spacing scale", "type": "json", "jsonSchema": {"type": "object", "additionalProperties": {"type": ["string", "number"]}} },
        { "name": "Text", "displayName": "Type scale", "type": "json", "jsonSchema": {"type": "object", "additionalProperties": {"type": ["string", "number", "object"]}} },
        { "name": "Collections", "displayName": "Collections", "type": "json", "jsonSchema": {"type": "object", "additionalProperties": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string"}, "route": {"type": "string"}, "fields": {"type": "object"}, "sort": {"type": "string"}, "label": {"type": "string"}, "noun": {"type": "array", "items": {"type": "string"}}, "pageSize": {"type": "integer", "minimum": 1, "maximum": 100}}}} },
        { "name": "OptionColors", "displayName": "Colours per option", "type": "json", "jsonSchema": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "string"}}} },
        { "name": "Variants", "displayName": "Visitor theme variants", "type": "json", "jsonSchema": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "label": {"type": "string"}, "colors": {"type": "object", "additionalProperties": {"type": "string"}}}}} },
        { "name": "TopBar", "displayName": "Top bar", "type": "json", "jsonSchema": {"type": "object", "properties": {"text": {"type": "string"}, "links": {"type": "array", "items": {"type": "object", "required": ["label", "href"], "properties": {"label": {"type": "string"}, "href": {"type": "string", "pattern": "^(/(?!/)|https?://)"}}}}}} },
        { "name": "HeaderLinks", "displayName": "Header links", "type": "json", "jsonSchema": {"type": "array", "items": {"type": "object", "required": ["label", "href"], "properties": {"label": {"type": "string"}, "href": {"type": "string", "pattern": "^(/(?!/)|https?://)"}, "activeOn": {"type": "string"}, "children": {"type": "array", "items": {"type": "object", "required": ["label", "href"], "properties": {"label": {"type": "string"}, "href": {"type": "string", "pattern": "^(/(?!/)|https?://)"}}}}}}} },
        { "name": "FooterColumns", "displayName": "Footer columns", "type": "json", "jsonSchema": {"type": "array", "items": {"type": "object", "properties": {"heading": {"type": "string"}, "links": {"type": "array", "items": {"type": "object", "required": ["label", "href"], "properties": {"label": {"type": "string"}, "href": {"type": "string", "pattern": "^(/(?!/)|https?://)"}}}}}}} },
        { "name": "SocialLinks", "displayName": "Social links", "type": "json", "jsonSchema": {"type": "array", "items": {"type": "object", "required": ["network", "href"], "properties": {"network": {"type": "string"}, "href": {"type": "string", "pattern": "^(/(?!/)|https?://)"}}}} },
        { "name": "About", "displayName": "About", "type": "text" },
        { "name": "Email", "displayName": "Contact email", "type": "string" },
        { "name": "Location", "displayName": "Location", "type": "string" },
        { "name": "LocationUrl", "displayName": "Location map link", "type": "url" },
        { "name": "ContactUrl", "displayName": "Contact link", "type": "url" },
        { "name": "SocialHandle", "displayName": "Social handle", "type": "string" },
        { "name": "Copyright", "displayName": "Copyright line", "type": "string" },
        { "name": "Mode", "displayName": "Site mode", "type": "choice", "options": [{"value": "Live", "label": "Live"}, {"value": "Holding", "label": "Holding"}] },
        { "name": "HoldingPath", "displayName": "Holding page path", "type": "string" },
        { "name": "HeaderPath", "displayName": "Header page path", "type": "string" },
        { "name": "HeaderTone", "displayName": "Header tone", "type": "choice", "options": [ { "value": "page", "label": "Page" }, { "value": "surface", "label": "Surface" }, { "value": "accent", "label": "Accent" }, { "value": "inverse", "label": "Inverse" }, { "value": "gradient", "label": "Gradient" }, { "value": "wash", "label": "Wash" } ] },
        { "name": "FooterPath", "displayName": "Footer page path", "type": "string" },
        { "name": "FooterTone", "displayName": "Footer tone", "type": "choice", "options": [ { "value": "page", "label": "Page" }, { "value": "surface", "label": "Surface" }, { "value": "accent", "label": "Accent" }, { "value": "inverse", "label": "Inverse" }, { "value": "gradient", "label": "Gradient" }, { "value": "wash", "label": "Wash" } ] },
        { "name": "Tokens", "displayName": "Design tokens", "type": "json", "jsonSchema": {"type": "object", "additionalProperties": {"type": "string"}} },
        { "name": "Tones", "displayName": "Tones", "type": "json", "jsonSchema": {"type": "object", "additionalProperties": {"type": "object", "properties": {"ink": {"type": "string"}, "bg": {"type": "string"}, "edge": {"type": "string"}}}} },
        { "name": "StyleRecipes", "displayName": "Style recipes", "type": "json", "jsonSchema": {"type": "object", "additionalProperties": {"type": "object", "properties": {"class": {"type": "string"}, "style": {"type": "object", "additionalProperties": {"type": "string"}}}}} },
        { "name": "MenuLinks", "displayName": "Phone menu links", "type": "json", "jsonSchema": {"type": "array", "items": {"type": "object", "required": ["label", "href"], "properties": {"label": {"type": "string"}, "href": {"type": "string", "pattern": "^(/(?!/)|https?://)"}, "activeOn": {"type": "string"}, "children": {"type": "array", "items": {"type": "object", "required": ["label", "href"], "properties": {"label": {"type": "string"}, "href": {"type": "string", "pattern": "^(/(?!/)|https?://)"}}}}}}} },
        { "name": "HeaderActions", "displayName": "Header actions", "type": "json", "jsonSchema": {"type": "array", "maxItems": 4, "items": {"type": "object", "required": ["label", "href"], "properties": {"label": {"type": "string"}, "href": {"type": "string", "pattern": "^(/(?!/)|https?://)"}, "variant": {"enum": ["primary", "secondary", "plain"]}}}} },
        { "name": "Plugins", "displayName": "Enabled plugins", "type": "json", "jsonSchema": {"type": "array", "items": {"type": "string"}} },
        { "name": "Presets", "displayName": "Saved blocks", "type": "json" },
        { "name": "HomePath", "displayName": "Home page path", "type": "string" },
        { "name": "Labels", "displayName": "Visitor-facing words", "type": "json", "jsonSchema": {"type": "object", "additionalProperties": {"type": "string"}} },
        { "name": "OptionStyles", "displayName": "Styles per option", "type": "json", "jsonSchema": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "object", "properties": {"tone": {"type": "string"}, "icon": {"type": "string"}, "label": {"type": "string"}}}}} }
      ]
    }
  ]
}

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>BarakoCMS</PackageId>
    <Version>3.21.0</Version>

    <Description>The AI-Native, High-Performance Headless CMS for .NET 10. Plugin-based workflow system with 6 built-in actions, advanced RBAC, event sourcing, and production-grade security.</Description>
    <IsPackable>true</IsPackable>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>

    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <!-- SPDX expression rather than a bundled file: it matches the modules and lets NuGet
         render the licence inline. Versions up to 3.1.1 shipped under Apache-2.0 and stay
         that way; 3.2.0 onward is MPL-2.0, so the whole suite is one licence. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Ship the XML doc file for the documented public API, but don't warn on members without
         XML comments (CS1591). Keeps consumer and project-reference builds quiet. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>c77ffe8f-737f-455c-ae23-d3686cd5edd9</UserSecretsId>
    
    <!-- Design & Code Quality -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- This is a Microsoft.NET.Sdk.Web project, where appsettings*.json are Content items, and
         pack ships Content by default. The published 3.21.0 package really did carry
         content/appsettings.json and contentFiles/any/net10.0/appsettings.json, so referencing
         BarakoCMS dropped the host's own configuration into the consumer's project, to collide with
         theirs at build and publish. The package is a library; its consumer owns its configuration.

         Scoped to these files rather than IncludeContentInPack=false, which also drops the icon and
         the README and fails the pack with NU5046. -->
    <Content Update="appsettings*.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.Npgsql" />
    <PackageReference Include="AspNetCore.HealthChecks.System" />
    <PackageReference Include="AspNetCore.HealthChecks.UI" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.InMemory.Storage" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="FastEndpoints.Swagger" />
    <PackageReference Include="FastEndpoints.Security" />
    <PackageReference Include="JasperFx" />
    <PackageReference Include="KubernetesClient" />
    <PackageReference Include="Marten" />
    <PackageReference Include="Microsoft.Extensions.DependencyModel" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="prometheus-net.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="IdentityModel" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>


  <ItemGroup>
    <!-- ModuleConfigurationScopeTests asserts on ModuleConfiguration, which is deliberately
         internal: it is how the host scopes a module's settings, not public API, and CLAUDE.md
         section 6 means anything public here is a compatibility commitment. -->
    <InternalsVisibleTo Include="BarakoCMS.Tests" />
    <!-- Castle DynamicProxy, which NSubstitute builds on, needs to see internal types to mock an
         ILogger<T> whose T is internal. The feature slices became internal in 4.0, so several
         existing workflow-action tests could not construct their own subject without this. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>

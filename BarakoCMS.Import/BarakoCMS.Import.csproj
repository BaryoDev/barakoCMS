<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BarakoCMS.Import</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BarakoCMS.Import</PackageId>
    <Version>4.2.2</Version>
    <Description>Optional bulk-import module for barakoCMS: analyze .xlsx/CSV uploads and bulk-create content. Zero-dependency parsing via Talaan.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <ProjectReference Include="..\barakoCMS\barakoCMS.csproj" />
    <!-- Talaan is consumed as a published NuGet package so this module builds standalone (CI, NuGet). -->
    <PackageReference Include="Talaan" />
  </ItemGroup>
</Project>

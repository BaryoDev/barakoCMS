<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BarakoCMS.Email.Resend</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BarakoCMS.Email.Resend</PackageId>
    <Version>4.5.0</Version>
    <Description>Resend email-provider module for barakoCMS: implements IEmailService via the Resend HTTP API, plus a delivery webhook that records bounces/complaints as EmailEvent documents.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BarakoCMS.Abstractions\BarakoCMS.Abstractions.csproj" />
    <ProjectReference Include="..\barakoCMS\barakoCMS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="BarakoCMS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- This module's migration, shipped in its own assembly so db-migrate records it under the
         module and runs it only where the module is enabled. See MODULES.md, "Migrations". -->
    <EmbeddedResource Include="..\migrations\4.5.0\email-sent-emails.sql" LogicalName="barako-migrations/4.5.0/email-sent-emails.sql" />
  </ItemGroup>
</Project>

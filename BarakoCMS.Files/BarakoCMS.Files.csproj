<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BarakoCMS.Files</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BarakoCMS.Files</PackageId>
    <Version>4.4.0</Version>
    <Description>Optional file-attachment module for barakoCMS: upload and retrieve files (receipts, photos, documents) stored in Postgres via Marten.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BarakoCMS.Abstractions\BarakoCMS.Abstractions.csproj" />
    <ProjectReference Include="..\barakoCMS\barakoCMS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <!-- This module's migration, shipped in its own assembly so db-migrate records it under the
         module and runs it only where the module is enabled. See MODULES.md, "Migrations". -->
    <EmbeddedResource Include="..\migrations\4.2.0\stored-files-parent-index.sql" LogicalName="barako-migrations/4.2.0/stored-files-parent-index.sql" />
  </ItemGroup>
</Project>

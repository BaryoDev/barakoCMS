<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BarakoCMS.Services</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BarakoCMS.Services</PackageId>
    <Version>5.2.0</Version>
    <Description>Registry of outside services for barakoCMS: register a service, take its heartbeats, and see whether it is Healthy, Late or Down. The base the message state and operator actions build on.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BarakoCMS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BarakoCMS.Abstractions\BarakoCMS.Abstractions.csproj" />
    <ProjectReference Include="..\barakoCMS\barakoCMS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>
</Project>

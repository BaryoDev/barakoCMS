# barakoCMS production environment, for docker-compose.prod.yml.
#
#   cp .env.prod.example .env
#   docker compose -f docker-compose.prod.yml up -d
#
# Every value without a default is required. The stack refuses to start rather than falling
# back to something unsuitable, so a missing variable is an error at boot instead of a
# security problem found later.
#
# NEVER commit your real .env.

# --- Domain ------------------------------------------------------------------
# Must already resolve to this machine before the first start. Caddy requests a TLS
# certificate immediately and Let's Encrypt validates over HTTP.
DOMAIN_API=api.example.com

# Contact address for the certificate authority. Expiry warnings go here.
ACME_EMAIL=you@example.com

# --- The browsers that may call this API ---------------------------------------
# Comma-separated origins allowed to call the API from a browser. Include the scheme, no
# trailing slash. Put the console's origin here (barakoBrew, wherever you host it) and
# your own site:
#
#   FRONTEND_ORIGINS=https://admin.example.com,https://www.example.com
FRONTEND_ORIGINS=https://admin.example.com,https://www.example.com

# --- Version -----------------------------------------------------------------
# Pin it. With a default, the next `docker compose pull` is an unplanned upgrade.
# Published tags: https://github.com/BaryoDev/barakoCMS/pkgs/container/barako-cms
BARAKO_TAG=3.21.0

# --- Database ----------------------------------------------------------------
DB_NAME=barako_cms
DB_USER=postgres
# Required. Generate one: openssl rand -base64 24
DB_PASSWORD=
# The API connects as this role, which has no superuser. A job runs scripts/db-app-role.sql as the
# owner before the API starts and creates the role or updates its password. Required.
# Generate one: openssl rand -base64 24. Keep it different from DB_PASSWORD.
DB_APP_USER=barako_app
DB_APP_PASSWORD=

# --- Security ----------------------------------------------------------------
# JWT signing key. At least 32 characters or the API refuses to start.
# Generate one: openssl rand -base64 48
# Changing this later invalidates every issued token, so treat rotation as a migration.
JWT_KEY=

# First admin, seeded on first start. This is your first sign-in.
# Generate a password: openssl rand -base64 18
ADMIN_USER=admin
ADMIN_PASSWORD=

# The proxy network. Caddy sits on its own network with a fixed address, and the app trusts
# X-Forwarded-For from that one address and nowhere else. Change these only if 10.87.51.0/28
# overlaps a Docker network, VPN or LAN route on this host. See docs/deploy-in-production.md.
# PROXY_SUBNET=10.87.51.0/28
# PROXY_ADDRESS=10.87.51.2
# The part of the subnet Docker hands out automatically. It must sit inside PROXY_SUBNET and leave
# PROXY_ADDRESS out. If you change PROXY_SUBNET, set this too.
# PROXY_IP_RANGE=10.87.51.8/29
# An extra range to trust on top of PROXY_ADDRESS. Leave it unset: a range such as the Docker
# bridge lets any container on that network choose the client IP the audit log records.
# TRUSTED_PROXY_NETWORK=

# --- Backups -----------------------------------------------------------------
# Written to the postgres_prod_backups volume. Nightly at 02:00, keeping two weeks.
# A backup nobody has restored is not a backup. See docs/backup-and-restore.md.
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_KEEP_DAYS=14

# --- Optional modules ---------------------------------------------------------
# Module settings are read by the app, not by compose, so a variable here does nothing on
# its own. Add the ones you want to the `app` service's `environment:` block in
# docker-compose.prod.yml. quickstart/docker-compose.yml lists every module's keys, and
# each one stays off or mocked until you fill it in.

# --- Resource limits (optional) ----------------------------------------------
# Each service has a memory and process cap, so one runaway container cannot take the host down.
# The defaults are generous. Raise API_MEM_LIMIT before a large import or a big file upload, for
# example API_MEM_LIMIT=2g, and DB_MEM_LIMIT together with PG_SHARED_BUFFERS on a bigger server.
# Do not set a value to 0 or -1, which removes the cap.
# API_MEM_LIMIT=1g
# API_PIDS_LIMIT=512
# API_TMP_SIZE=512m          # scratch space for uploads in flight, held in memory. 0 removes the cap, so do not set it
# DB_MEM_LIMIT=2g
# DB_PIDS_LIMIT=512
# PROXY_MEM_LIMIT=512m
# PROXY_PIDS_LIMIT=256
# BACKUP_MEM_LIMIT=512m
# BACKUP_PIDS_LIMIT=128
# EXTENSIONS_MEM_LIMIT=128m
# EXTENSIONS_PIDS_LIMIT=64
# The backup container has a read-only root file system. The off-host copy installs curl on first
# start, which needs a writable one, so set BACKUP_READ_ONLY=false only when BACKUP_S3_BUCKET is set.
# BACKUP_READ_ONLY=true

# Leave empty unless you use docker-compose.secrets.yml.
SECRETS_AS_FILES=

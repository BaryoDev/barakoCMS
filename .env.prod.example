# barakoCMS production environment, for docker-compose.prod.yml.
#
#   cp .env.prod.example .env
#   docker compose -f docker-compose.prod.yml up -d
#
# Every value without a default is required. The stack refuses to start rather than falling
# back to something unsuitable, so a missing variable is an error at boot instead of a
# security problem found later.
#
# NEVER commit your real .env.

# --- Domains -----------------------------------------------------------------
# Both must already resolve to this machine before the first start. Caddy requests TLS
# certificates immediately and Let's Encrypt validates over HTTP.
DOMAIN_API=api.example.com
DOMAIN_ADMIN=admin.example.com

# Contact address for the certificate authority. Expiry warnings go here.
ACME_EMAIL=you@example.com

# --- The frontend you are about to build --------------------------------------
# Comma-separated origins allowed to call the API from a browser. Include the scheme, no
# trailing slash. The admin domain is added for you, so this is your own site:
#
#   FRONTEND_ORIGINS=https://www.example.com,https://example.com
#
# If you have no frontend yet, set it to the admin domain so the value is not empty.
FRONTEND_ORIGINS=https://www.example.com

# --- Version -----------------------------------------------------------------
# Pin it. With a default, the next `docker compose pull` is an unplanned upgrade.
# Published tags: https://github.com/BaryoDev/barakoCMS/pkgs/container/barako-cms
BARAKO_TAG=3.21.0

# --- Database ----------------------------------------------------------------
DB_NAME=barako_cms
DB_USER=postgres
# Required. Generate one: openssl rand -base64 24
DB_PASSWORD=

# --- Security ----------------------------------------------------------------
# JWT signing key. At least 32 characters or the API refuses to start.
# Generate one: openssl rand -base64 48
# Changing this later invalidates every issued token, so treat rotation as a migration.
JWT_KEY=

# First admin, seeded on first start. This is your admin-UI login.
# Generate a password: openssl rand -base64 18
ADMIN_USER=admin
ADMIN_PASSWORD=

# The network Caddy reaches the app from. Only change this if your Docker bridge is not in
# the default range; the app trusts X-Forwarded-For from here and nowhere else.
# TRUSTED_PROXY_NETWORK=172.16.0.0/12

# --- Backups -----------------------------------------------------------------
# Written to the postgres_prod_backups volume. Nightly at 02:00, keeping two weeks.
# A backup nobody has restored is not a backup. See docs/backup-and-restore.md.
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_KEEP_DAYS=14

# --- Optional modules ---------------------------------------------------------
# Module settings are read by the app, not by compose, so a variable here does nothing on
# its own. Add the ones you want to the `app` service's `environment:` block in
# docker-compose.prod.yml. quickstart/docker-compose.yml lists every module's keys, and
# each one stays off or mocked until you fill it in.

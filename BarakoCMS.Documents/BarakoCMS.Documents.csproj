<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BarakoCMS.Documents</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BarakoCMS.Documents</PackageId>
    <Version>5.2.0</Version>
    <Description>Document generation for barakoCMS: render an entry to a PDF from a narrow template language, drawn natively with SkiaSharp, and store it through the Files module. No browser, and a template cannot fetch anything.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BarakoCMS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BarakoCMS.Abstractions\BarakoCMS.Abstractions.csproj" />
    <ProjectReference Include="..\barakoCMS\barakoCMS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="barako-fonts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fonts\LICENSE-LiberationSans.txt" LogicalName="barako-fonts/LICENSE-LiberationSans.txt" />
    <EmbeddedResource Include="..\migrations\5.2.0\585-documents.sql" LogicalName="barako-migrations/5.2.0/585-documents.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>
</Project>

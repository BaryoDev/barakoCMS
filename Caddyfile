{
    # Global Options
    email {$ACME_EMAIL}
}

{$DOMAIN_API} {
    # No cache handler here on purpose: edge caching is expected from a CDN in
    # front of this stack. See docs/deploy-in-production.md ("Putting a shared
    # cache or CDN in front of it"). Self-hosting with only this reverse_proxy
    # reaches Postgres on every public read.
    reverse_proxy app:8080

    # Caddy announces itself twice by default: a Server header, and a Via header that reverse_proxy
    # adds to every response. Neither helps a client, and both name the proxy software. HSTS is not
    # set here, the API sends it.
    header {
        -Server
        -Via
    }
}

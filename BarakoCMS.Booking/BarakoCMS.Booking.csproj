<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BarakoCMS.Booking</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>BarakoCMS.Booking</PackageId>
    <Version>5.2.1</Version>
    <Description>Booking for barakoCMS: resources with a time zone, weekly opening hours and exceptions, bookings as content entries that a lifecycle hook refuses when they overlap another active booking of the same resource, and a public availability route that returns free slots only.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BarakoCMS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BarakoCMS.Abstractions\BarakoCMS.Abstractions.csproj" />
    <ProjectReference Include="..\barakoCMS\barakoCMS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module's own table, for db-migrate (docs/migrations.md). -->
    <EmbeddedResource Include="..\migrations\5.2.0\booking-resources.sql" LogicalName="barako-migrations/5.2.0/booking-resources.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>
</Project>

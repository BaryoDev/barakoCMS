<Project>

  <!-- Settings shared by every project. A project may still override any of these locally,
       but nothing here should need to be repeated in a .csproj. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Arnel Robles</Authors>
    <Company>BaryoDev</Company>
    <Product>BarakoCMS</Product>
    <Copyright>Copyright © BaryoDev</Copyright>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/baryodev/barakoCMS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/baryodev/barakoCMS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Every package carries the bean, so the modules read as one family on nuget.org rather than
         as a dozen unrelated packages sharing a prefix. -->
    <PackageIcon>icon.png</PackageIcon>

    <!-- `barakocms-module` is the discovery tag: one search on nuget.org returns the whole module
         set. Umbraco does the same with `umbraco-marketplace`, which is what gets a community
         package listed rather than merely published. A module may append its own tags. -->
    <PackageTags>barakocms;barakocms-module;headless-cms;cms;dotnet;aspnetcore;marten</PackageTags>
  </PropertyGroup>

  <!-- A package with no README renders as an empty page on nuget.org, which is where most people
       decide whether to install it. Conditional so adding a project never breaks the build; the
       packaging test asserts every packable project actually has one. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Ship XML docs so consumers get IntelliSense on the public API. The doc comments in this
       codebase carry most of the "why", and without this they stop at the assembly boundary.
       CS1591 is silenced: warning on every undocumented public member would bury real warnings. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Source Link + symbols: a consumer debugging into a module steps into real source instead of
       decompiled output. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Per-module icon when the project ships one, else the shared BarakoDev icon. Both pack as
         icon.png, so PackageIcon stays a single inherited value in this file. -->
    <None Include="$(MSBuildProjectDirectory)/assets/icon.png" Pack="true" PackagePath="/" Visible="false" Condition="Exists('$(MSBuildProjectDirectory)/assets/icon.png')" />
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="/" Visible="false" Condition="!Exists('$(MSBuildProjectDirectory)/assets/icon.png')" />
    <None Include="README.md" Pack="true" PackagePath="/" Condition="Exists('$(MSBuildProjectDirectory)/README.md')" />
  </ItemGroup>

  <PropertyGroup>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Deterministic paths on the build server so binaries are reproducible.
       https://github.com/clairernovotny/DeterministicBuilds -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Every project writes packages.lock.json and commits it. A transitive bump then shows up as a
       diff instead of arriving silently, and CI restores in locked mode so a stale lock fails
       the build rather than being regenerated. It is also what makes GitHub attribute the
       dependency graph to this repository (#158). -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
